	<ideo>
		<overriddenWorshipRoomLabel>Noctuary</overriddenWorshipRoomLabel>
		<foundation Class="IdeoFoundation_Deity">
			<def>Deity</def>
			<place>Zoutera</place>
			<deities>
				<li>
					<name>Kira</name>
					<type>God of Hunger</type>
					<gender>Male</gender>
					<iconPath>UI/Deities/DeityGeneric</iconPath>
					<relatedMeme>Bloodfeeding</relatedMeme>
				</li>
				<li>
					<name>Umbra</name>
					<type>Spirit of Violence</type>
					<gender>Female</gender>
					<iconPath>UI/Deities/DeityGeneric</iconPath>
					<relatedMeme>Supremacist</relatedMeme>
				</li>
			</deities>
		</foundation>
		<name>Ethernal Veil</name>
		<adjective>Ethernal</adjective>
		<memberName>Veilist</memberName>
		<leaderTitleMale>Veilfather</leaderTitleMale>
		<leaderTitleFemale>Veilmother</leaderTitleFemale>
		<description>&lt;color=#D09B61FF&gt;Kira&lt;/color&gt; granted us the knowledge of technology, that we may use it to improve and remake ourselves in his perfect image. The God of Hunger &lt;color=#D09B61FF&gt;Kira&lt;/color&gt; gave to his chosen followers the gift of red hunger, so that they might know true strength. The faithful fought the unbelievers, and &lt;color=#D09B61FF&gt;Kira&lt;/color&gt; said, "Fight them, everywhere, in my name, until I am worshipped throughout the universe and the true peace may finally reign."</description>
		<descriptionTemplate>%%Deity0_name%% granted us the knowledge of technology, that we may use it to improve and remake ourselves in %%deity0_possessive%% perfect image. The %%deity0_type%% %%deity0_name%% gave to %%deity0_possessive%% chosen followers the gift of red hunger, so that they might know true strength. The faithful fought the unbelievers, and %%deity0_name%% said, "Fight them, everywhere, in my name, until I am worshipped throughout the universe and the true peace may finally reign."</descriptionTemplate>
		<descriptionLocked>True</descriptionLocked>
		<culture>Astropolitan</culture>
		<iconDef>AbstractsD</iconDef>
		<colorDef>DarkSapphire</colorDef>
		<memes>
			<li>Structure_TheistEmbodied</li>
			<li>Supremacist</li>
			<li>Transhumanist</li>
			<li>Bloodfeeding</li>
		</memes>
