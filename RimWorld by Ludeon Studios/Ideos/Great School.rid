	<ideo>
		<foundation Class="IdeoFoundation_Deity">
			<def>Deity</def>
			<place>Zoutera</place>
			<deities>
				<li>
					<name>Kistor</name>
					<type>Spirit of Life</type>
					<gender>Female</gender>
					<iconPath>UI/Deities/DeityGeneric</iconPath>
					<relatedMeme>Structure_TheistEmbodied</relatedMeme>
				</li>
				<li>
					<name>Bino</name>
					<type>Master of Life</type>
					<gender>Male</gender>
					<iconPath>UI/Deities/DeityGeneric</iconPath>
					<relatedMeme>Structure_TheistEmbodied</relatedMeme>
				</li>
			</deities>
		</foundation>
		<name>Great School</name>
		<adjective>spiritual</adjective>
		<memberName>Spiritist</memberName>
		<leaderTitleMale>Divine Dictator</leaderTitleMale>
		<leaderTitleFemale>Divine Dictator</leaderTitleFemale>
		<description>The people of the grassy dino-world Zoutera squabbled endlessly, and &lt;color=#D09B61FF&gt;Kistor&lt;/color&gt; became tired of discord and anointed the Spiritists as the rightful rulers of all. Human bio-engineers studied the works of &lt;color=#D09B61FF&gt;Kistor&lt;/color&gt;, which pleased her. The Spirit of Life &lt;color=#D09B61FF&gt;Kistor&lt;/color&gt; gave to her chosen followers the gift of red hunger, so that they might know true strength.</description>
		<descriptionTemplate>The people of the grassy dino-world Zoutera squabbled endlessly, and %%deity0_name%% became tired of discord and anointed the %%memberNamePlural%% as the rightful rulers of all. Human bio-engineers studied the works of %%deity0_name%%, which pleased %%deity0_objective%%. The %%deity0_type%% %%deity0_name%% gave to %%deity0_possessive%% chosen followers the gift of red hunger, so that they might know true strength.</descriptionTemplate>
		<culture>Astropolitan</culture>
		<iconDef>SpiralsD</iconDef>
		<colorDef>Red</colorDef>
		<memes>
			<li>Structure_TheistEmbodied</li>
			<li>Supremacist</li>
			<li>Transhumanist</li>
			<li>Bloodfeeding</li>
		</memes>
