					<id>111</id>
					<name>Gentle Huskies</name>
					<appearanceTick>16739000</appearanceTick>
					<acceptanceTick>17108647</acceptanceTick>
					<ticksUntilAcceptanceExpiry>69928</ticksUntilAcceptanceExpiry>
