				<li>
					<id>19</id>
					<name>Bishop's Yeoman Ceremony</name>
					<appearanceTick>5768592</appearanceTick>
					<acceptanceTick>5769055</acceptanceTick>
					<ticksUntilAcceptanceExpiry>599536</ticksUntilAcceptanceExpiry>
