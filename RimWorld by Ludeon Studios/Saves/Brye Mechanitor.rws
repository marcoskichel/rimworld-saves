							<deities>
								<li>
									<name>Bamarbust</name>
									<type>Creator of Violence</type>
									<gender>Female</gender>
									<iconPath>UI/Deities/DeityGeneric</iconPath>
									<relatedMeme>Supremacist</relatedMeme>
								</li>
								<li>
									<name>Bra'barbai</name>
									<type>Spirit of Theft</type>
