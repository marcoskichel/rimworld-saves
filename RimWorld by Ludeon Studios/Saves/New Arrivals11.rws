						<name>Arch-Steelism</name>
						<adjective>steelist</adjective>
						<memberName>Steeler</memberName>
						<leaderTitleMale>High Stellarch</leaderTitleMale>
						<leaderTitleFemale>High Stellarch</leaderTitleFemale>
						<description>The archotechs' demand is simple: Follow their designated path, and no other. Technology allows humans to be more like the archotechs. In the end, by observing humanity, the archotechs will finally understand their purpose, and lift confident humanity up to rule them.</description>
						<descriptionTemplate>The archotechs' demand is simple: Follow their designated path, and no other. Technology allows humans to be more like the archotechs. In the end, by observing humanity, the archotechs will finally understand their purpose, and lift confident humanity up to rule them.</descriptionTemplate>
						<culture>Sophian</culture>
						<iconDef>CirclesC</iconDef>
						<colorDef>LightGrey</colorDef>
						<primaryFactionColor>RGBA(1.000, 1.000, 1.000, 1.000)</primaryFactionColor>
