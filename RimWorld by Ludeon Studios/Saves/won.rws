				<li>
					<id>1</id>
					<name>Stanislav's Heat Wave</name>
					<appearanceTick>629000</appearanceTick>
					<acceptanceTick>639309</acceptanceTick>
					<ticksUntilAcceptanceExpiry>107278</ticksUntilAcceptanceExpiry>
					<acceptedBy>null</acceptedBy>
