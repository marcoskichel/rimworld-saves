						<name>Shiva's Vine</name>
						<adjective>Shivaic</adjective>
						<memberName>Shivaite</memberName>
						<leaderTitleMale>Root Chief</leaderTitleMale>
						<leaderTitleFemale>Root Chief</leaderTitleFemale>
						<description>&lt;color=#D09B61FF&gt;Shiva&lt;/color&gt; rooted the trees firmly in the ground, yet made them grow steadily towards heaven. This is &lt;color=#D09B61FF&gt;Shiva&lt;/color&gt;'s first lesson on how to know her. Though many adventurers moved against her, &lt;color=#D09B61FF&gt;Shiva&lt;/color&gt; prevented them easily, for she was God of Destruction. &lt;color=#D09B61FF&gt;Shiva&lt;/color&gt; said to all, "Each and every one of you is a unique and holy being formed in my image."</description>
						<descriptionTemplate>%%Deity0_name%% rooted the trees firmly in the ground, yet made them grow steadily towards heaven. This is %%deity0_name%%'s first lesson on how to know %%deity0_objective%%. Though many adventurers moved against %%deity0_objective%%, %%deity0_name%% prevented them easily, for %%deity0_pronoun%% was %%deity0_type%%. %%Deity0_name%% said to all, "Each and every one of you is a unique and holy being formed in my image."</descriptionTemplate>
						<culture>Corunan</culture>
						<iconDef>ReligionD</iconDef>
						<colorDef>LightOlive</colorDef>
						<primaryFactionColor>RGBA(0.479, 0.948, 0.502, 1.000)</primaryFactionColor>
						<memes>
							<li>Structure_OriginHindu</li>
							<li>Individualist</li>
							<li>TreeConnection</li>
						</memes>
						<precepts>
							<li Class="Precept_Ritual">
								<name>Funeral of Shiva</name>
								<def>Funeral</def>
								<ID>155</ID>
								<randomSeed>46710212</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
								<nameMaker>NamerRitualFuneral</nameMaker>
								<ritualOnlyForIdeoMembers>True</ritualOnlyForIdeoMembers>
								<ritualExpectedDesc>Once a {IDEO} member dies, other {MEMBERS} gather around their grave for {RITUAL_labelDef}.</ritualExpectedDesc>
								<playsIdeoMusic>True</playsIdeoMusic>
								<generatedAttachedReward>True</generatedAttachedReward>
								<sourcePattern>FuneralStandard</sourcePattern>
								<obligationTargetFilter Class="RitualObligationTargetWorker_GraveWithTarget">
									<def>GraveWithTargetsCorpse</def>
									<parent>Precept_155</parent>
								</obligationTargetFilter>
								<targetFilter IsNull="True" />
								<behavior Class="RitualBehaviorWorker_Funeral">
									<def>Funeral</def>
								</behavior>
