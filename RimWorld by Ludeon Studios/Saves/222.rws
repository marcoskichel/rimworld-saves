								<label>Diabolus summoned</label>
								<lookTargets IsNull="True" />
								<relatedFaction>Faction_12</relatedFaction>
								<text>Attracted by your mech-band signals, an ultra-heavy mech from (*Faction=Faction_12)Nyaralph Mechhive(/Faction) will arrive soon. Be prepared.</text>
								<quest>Quest_89</quest>
								<hyperlinkThingDefs IsNull="True" />
								<hyperlinkHediffDefs IsNull="True" />
							</letter>
