		<components>
			<li Class="GameComponent_DebugTools" />
			<li Class="GameComponent_OnetimeNotification" />
			<li Class="GameComponent_Anomaly">
				<level>5</level>
				<highestLevelReached>5</highestLevelReached>
				<levelDef>Embraced</levelDef>
				<monolith>null</monolith>
				<nextHarbingerTreeCheckTick>46988760</nextHarbingerTreeCheckTick>
				<lastLevelChangeTick>46173229</lastLevelChangeTick>
				<hasSeenGrayFlesh>True</hasSeenGrayFlesh>
				<hasPerformedVoidProvocation>True</hasPerformedVoidProvocation>
				<lastLevelActivationLetterSent>2</lastLevelActivationLetterSent>
				<voidNodeActivator>Thing_Human782</voidNodeActivator>
				<metalHellPawns />
				<metalHellReturnTick>-99999</metalHellReturnTick>
				<fireGrayPallTick>-99999</fireGrayPallTick>
				<newestMetalhorrorBiosignatureTick>37322000</newestMetalhorrorBiosignatureTick>
