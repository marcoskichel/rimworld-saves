					<appearanceTick>2409000</appearanceTick>
					<acceptanceTick>2410507</acceptanceTick>
					<ticksUntilAcceptanceExpiry>375561</ticksUntilAcceptanceExpiry>
					<acceptedBy>null</acceptedBy>
