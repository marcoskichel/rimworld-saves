						<name>Creed of Unity</name>
						<adjective>unitary</adjective>
						<memberName>Unitist</memberName>
						<leaderTitleMale>Ethical Chair</leaderTitleMale>
						<leaderTitleFemale>Ethical Chair</leaderTitleFemale>
						<description>"One lesson was hardest for my followers to accept: My death, and yours, will mean nothing, as long as our people go on. Everything that has happened since has reinforced that fact."

  - &lt;i&gt;Solidarity Family&lt;/i&gt; by Carissa DelMartino</description>
						<descriptionTemplate>"One lesson was hardest for my followers to accept: My death, and yours, will mean nothing, as long as our people go on. Everything that has happened since has reinforced that fact."

  - &lt;i&gt;Solidarity Family&lt;/i&gt; by Carissa DelMartino</descriptionTemplate>
						<culture>Rustican</culture>
						<iconDef>GeometryA</iconDef>
						<colorDef>LightBlue</colorDef>
						<primaryFactionColor>RGBA(0.412, 0.362, 0.787, 1.000)</primaryFactionColor>
						<memes>
							<li>Structure_Ideological</li>
							<li>Collectivist</li>
						</memes>
						<precepts>
							<li>
								<name>drug use</name>
								<def>DrugUse_MedicalOnly</def>
								<ID>2</ID>
								<randomSeed>-922997027</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
							</li>
							<li Class="Precept_Ritual">
								<name>Undivided Interment</name>
								<def>Funeral</def>
								<ID>3</ID>
								<randomSeed>-2049668786</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
								<nameMaker>NamerRitualFuneral</nameMaker>
								<ritualOnlyForIdeoMembers>True</ritualOnlyForIdeoMembers>
								<ritualExpectedDesc>Once a {IDEO} member dies, other {MEMBERS} gather around their grave for {RITUAL_labelDef}.</ritualExpectedDesc>
								<playsIdeoMusic>True</playsIdeoMusic>
								<generatedAttachedReward>True</generatedAttachedReward>
								<sourcePattern>FuneralStandard</sourcePattern>
								<obligationTargetFilter Class="RitualObligationTargetWorker_GraveWithTarget">
									<def>GraveWithTargetsCorpse</def>
									<parent>Precept_3</parent>
								</obligationTargetFilter>
								<targetFilter IsNull="True" />
								<behavior Class="RitualBehaviorWorker_Funeral">
									<def>Funeral</def>
								</behavior>
